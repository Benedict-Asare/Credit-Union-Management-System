<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.creditunion.controller.LoginController">

    <padding>
        <Insets top="50" right="100" bottom="50" left="100"/>
    </padding>

    <!-- Logo/Icon Section -->
    <VBox alignment="CENTER" spacing="10">
        <Label text="🏦" style="-fx-font-size: 64px;"/>
        <Label text="Credit Union Management System" styleClass="title-label">
            <font>
                <Font name="System Bold" size="28"/>
            </font>
        </Label>
        <Label text="Secure Banking Portal" styleClass="subtitle-label">
            <font>
                <Font size="14"/>
            </font>
        </Label>
        <Separator prefWidth="300"/>
    </VBox>

    <!-- Login Form -->
    <GridPane hgap="15" vgap="15" alignment="CENTER" styleClass="login-form">
        <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
        </padding>

        <Label text="User Type:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-label"/>
        <ComboBox fx:id="userTypeCombo" GridPane.rowIndex="0" GridPane.columnIndex="1"
                  prefWidth="250" promptText="Select user type" styleClass="form-combo">
            <style>
                -fx-font-size: 14px;
            </style>
        </ComboBox>

        <Label text="Username:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="form-label"/>
        <TextField fx:id="usernameField" GridPane.rowIndex="1" GridPane.columnIndex="1"
                   prefWidth="250" promptText="Enter your username" styleClass="form-field"/>

        <Label text="Password:" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="form-label"/>
        <PasswordField fx:id="passwordField" GridPane.rowIndex="2" GridPane.columnIndex="1"
                       prefWidth="250" promptText="Enter your password" styleClass="form-field"/>

        <HBox spacing="15" alignment="CENTER" GridPane.rowIndex="3" GridPane.columnIndex="1"
              GridPane.columnSpan="2">
            <Button fx:id="loginButton" text="Login" onAction="#handleLogin" styleClass="login-button">
                <font>
                    <Font size="14"/>
                </font>
            </Button>
            <Button fx:id="cancelButton" text="Cancel" onAction="#handleCancel" styleClass="cancel-button">
                <font>
                    <Font size="14"/>
                </font>
            </Button>
        </HBox>

        <Label text="Demo Credentials:" GridPane.rowIndex="4" GridPane.columnIndex="0"
               GridPane.columnSpan="2" styleClass="help-text">
            <font>
                <Font size="11"/>
            </font>
        </Label>
        <Label text="Staff: admin / admin123 | Member: john / member123"
               GridPane.rowIndex="5" GridPane.columnIndex="0" GridPane.columnSpan="2"
               styleClass="help-text">
            <font>
                <Font size="11"/>
            </font>
        </Label>
    </GridPane>
</VBox>