<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.cell.PropertyValueFactory?>

<VBox spacing="0" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.creditunion.controller.StaffDashboardController">

    <MenuBar>
        <Menu text="File">
            <MenuItem text="Refresh" onAction="#handleRefreshMembers"/>
            <SeparatorMenuItem/>
            <MenuItem text="Logout" onAction="#handleLogout"/>
        </Menu>
        <Menu text="Actions">
            <MenuItem text="Register Member" onAction="#handleRegisterMember"/>
            <MenuItem text="Process Deposit" onAction="#handleDeposit"/>
            <MenuItem text="Process Payout" onAction="#handlePayout"/>
        </Menu>
        <Menu text="Help">
            <MenuItem text="About" onAction="#handleAbout"/>
        </Menu>
    </MenuBar>

    <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #0a5c8e;">
        <padding>
            <Insets top="15" right="20" bottom="15" left="20"/>
        </padding>
        <Label text="Staff Dashboard" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="welcomeLabel" style="-fx-text-fill: #ecf0f1; -fx-font-size: 14px;"/>
    </HBox>

    <TabPane fx:id="mainTabPane" VBox.vgrow="ALWAYS">
        <!-- Register Member Tab -->
        <Tab text="Register Member" closable="false">
            <ScrollPane fitToWidth="true" style="-fx-background-color: #e8f0fe;">
                <VBox spacing="20" style="-fx-padding: 30;">
                    <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 30; -fx-border-radius: 15px; -fx-background-radius: 15px; -fx-border-color: #bbdef5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 2);">
                        <Label text="Register New Member" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0a5c8e;"/>
                        <Separator/>
                        <GridPane hgap="20" vgap="18">
                            <Label text="Full Name:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-text-fill: #444; -fx-font-size: 13px;"/>
                            <TextField fx:id="regFullName" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="280" style="-fx-background-color: #f5f9ff; -fx-border-color: #bbdef5; -fx-border-radius: 5px; -fx-padding: 8;"/>

                            <Label text="Phone:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-text-fill: #444; -fx-font-size: 13px;"/>
                            <TextField fx:id="regPhone" GridPane.rowIndex="1" GridPane.columnIndex="1" style="-fx-background-color: #f5f9ff; -fx-border-color: #bbdef5; -fx-border-radius: 5px; -fx-padding: 8;"/>

                            <Label text="Email:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-text-fill: #444; -fx-font-size: 13px;"/>
                            <TextField fx:id="regEmail" GridPane.rowIndex="2" GridPane.columnIndex="1" style="-fx-background-color: #f5f9ff; -fx-border-color: #bbdef5; -fx-border-radius: 5px; -fx-padding: 8;"/>

                            <Label text="Address:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-text-fill: #444; -fx-font-size: 13px;"/>
                            <TextField fx:id="regAddress" GridPane.rowIndex="3" GridPane.columnIndex="1" style="-fx-background-color: #f5f9ff; -fx-border-color: #bbdef5; -fx-border-radius: 5px; -fx-padding: 8;"/>

                            <Label text="Username:" GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-text-fill: #444; -fx-font-size: 13px;"/>
                            <TextField fx:id="regUsername" GridPane.rowIndex="4" GridPane.columnIndex="1" style="-fx-background-color: #f5f9ff; -fx-border-color: #bbdef5; -fx-border-radius: 5px; -fx-padding: 8;"/>

                            <Label text="Password:" GridPane.rowIndex="5" GridPane.columnIndex="0" style="-fx-text-fill: #444; -fx-font-size: 13px;"/>
                            <PasswordField fx:id="regPassword" GridPane.rowIndex="5" GridPane.columnIndex="1" style="-fx-background-color: #f5f9ff; -fx-border-color: #bbdef5; -fx-border-radius: 5px; -fx-padding: 8;"/>

                            <Label text="Account Type:" GridPane.rowIndex="6" GridPane.columnIndex="0" style="-fx-text-fill: #444; -fx-font-size: 13px;"/>
                            <ComboBox fx:id="regAccountType" GridPane.rowIndex="6" GridPane.columnIndex="1" prefWidth="200" style="-fx-background-color: #f5f9ff;"/>
                        </GridPane>
                        <HBox alignment="CENTER_LEFT" style="-fx-padding: 15 0 0 0;">
                            <Button text="Register Member" onAction="#handleRegisterMember"
                                    style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12 35; -fx-background-radius: 5px; -fx-font-size: 14px;"/>
                        </HBox>
                    </VBox>
                </VBox>
            </ScrollPane>
        </Tab>

        <!-- Deposit Tab -->
        <Tab text="Deposit" closable="false">
            <VBox spacing="20" style="-fx-padding: 30;">
                <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 25; -fx-border-radius: 12px; -fx-background-radius: 12px; -fx-border-color: #bbdef5;">
                    <Label text="Process Deposit" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0a5c8e;"/>
                    <Separator/>
                    <GridPane hgap="15" vgap="15">
                        <Label text="Account Number:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-text-fill: #555;"/>
                        <TextField fx:id="depositAccountNumber" GridPane.rowIndex="0" GridPane.columnIndex="1" promptText="Enter account number" style="-fx-background-color: #f5f9ff;"/>
                        
                        <Label text="Amount:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-text-fill: #555;"/>
                        <TextField fx:id="depositAmount" GridPane.rowIndex="1" GridPane.columnIndex="1" promptText="Enter deposit amount" style="-fx-background-color: #f5f9ff;"/>
                        
                        <Label fx:id="depositBalanceLabel" GridPane.rowIndex="2" GridPane.columnIndex="1" style="-fx-text-fill: #27ae60; -fx-font-weight: bold; -fx-font-size: 16px;"/>
                    </GridPane>
                    <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-padding: 10 0 0 0;">
                        <Button text="Check Account" onAction="#handleCheckAccount"
                                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-padding: 10 25; -fx-background-radius: 5px;"/>
                        <Button text="Process Deposit" onAction="#handleDeposit"
                                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 25; -fx-background-radius: 5px;"/>
                    </HBox>
                </VBox>
            </VBox>
        </Tab>

        <!-- View Accounts Tab -->
        <Tab text="View Accounts" closable="false">
            <SplitPane dividerPositions="0.5">
                <VBox spacing="10">
                    <padding>
                        <Insets top="10" right="10" bottom="10" left="10"/>
                    </padding>
                    <Label text="Members" style="-fx-font-weight: bold; -fx-text-fill: #0a5c8e; -fx-font-size: 16px;"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button text="Search Member" onAction="#handleSearchMember"
                                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-padding: 5 12; -fx-background-radius: 4px;"/>
                        <Button text="Refresh" onAction="#handleRefreshMembers"
                                style="-fx-background-color: #7f8c8d; -fx-text-fill: white; -fx-padding: 5 12; -fx-background-radius: 4px;"/>
                    </HBox>
                    <TableView fx:id="memberTable" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-border-radius: 8px;">
                        <columns>
                            <TableColumn fx:id="memberNameColumn" text="Name" prefWidth="150"/>
                            <TableColumn fx:id="memberUsernameColumn" text="Username" prefWidth="100"/>
                            <TableColumn fx:id="memberPhoneColumn" text="Phone" prefWidth="100"/>
                            <TableColumn fx:id="memberEmailColumn" text="Email" prefWidth="150"/>
                        </columns>
                        <placeholder>
                            <Label text="No members found" style="-fx-text-fill: #999;"/>
                        </placeholder>
                    </TableView>
                </VBox>
                <VBox spacing="10">
                    <padding>
                        <Insets top="10" right="10" bottom="10" left="10"/>
                    </padding>
                    <Label text="Accounts" style="-fx-font-weight: bold; -fx-text-fill: #0a5c8e; -fx-font-size: 16px;"/>
                    <TableView fx:id="accountTable" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-border-radius: 8px;">
                        <columns>
                            <TableColumn fx:id="accountNumberColumn" text="Account Number" prefWidth="140"/>
                            <TableColumn fx:id="accountTypeColumn" text="Type" prefWidth="100"/>
                            <TableColumn fx:id="balanceColumn" text="Balance" prefWidth="120"/>
                            <TableColumn text="Status" prefWidth="90">
                                <cellValueFactory>
                                    <PropertyValueFactory property="status"/>
                                </cellValueFactory>
                            </TableColumn>
                            <TableColumn text="Member ID" prefWidth="80">
                                <cellValueFactory>
                                    <PropertyValueFactory property="memberId"/>
                                </cellValueFactory>
                            </TableColumn>
                        </columns>
                        <placeholder>
                            <Label text="Select a member to view their accounts" style="-fx-text-fill: #999;"/>
                        </placeholder>
                    </TableView>
                </VBox>
            </SplitPane>
        </Tab>

        <!-- Payout Tab -->
        <Tab text="Payout" closable="false">
            <VBox spacing="20" style="-fx-padding: 30;">
                <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 25; -fx-border-radius: 12px; -fx-background-radius: 12px; -fx-border-color: #bbdef5;">
                    <Label text="Process Payout" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #c0392b;"/>
                    <Separator/>
                    <GridPane hgap="15" vgap="15">
                        <Label text="Account Number:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-text-fill: #555;"/>
                        <TextField fx:id="payoutAccountNumber" GridPane.rowIndex="0" GridPane.columnIndex="1" promptText="Enter account number" style="-fx-background-color: #f5f9ff;"/>
                        
                        <Label text="Member Name:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-text-fill: #555;"/>
                        <Label fx:id="payoutMemberNameLabel" GridPane.rowIndex="1" GridPane.columnIndex="1" style="-fx-text-fill: #2c3e50; -fx-font-weight: bold;"/>
                        
                        <Label text="Current Balance:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-text-fill: #555;"/>
                        <Label fx:id="payoutBalanceLabel" GridPane.rowIndex="2" GridPane.columnIndex="1" style="-fx-text-fill: #e74c3c; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                    </GridPane>
                    <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-padding: 10 0 0 0;">
                        <Button text="Check Account" onAction="#handleCheckPayoutAccount"
                                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-padding: 10 25; -fx-background-radius: 5px;"/>
                        <Button text="Process Payout" onAction="#handlePayout"
                                style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 25; -fx-background-radius: 5px;"/>
                    </HBox>
                </VBox>
            </VBox>
        </Tab>

        <!-- Transactions Tab -->
        <Tab text="Transaction History" closable="false">
            <VBox spacing="15">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>
                <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 15; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-color: #bbdef5;">
                    <Label text="Search Transactions" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #0a5c8e;"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Account Number:" style="-fx-text-fill: #555;"/>
                        <TextField fx:id="transactionAccountNumber" promptText="Enter account number" prefWidth="200" style="-fx-background-color: #f5f9ff;"/>
                        <Button text="Search" onAction="#handleViewTransactions"
                                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-padding: 8 20; -fx-background-radius: 4px; -fx-font-weight: bold;"/>
                        <Button text="View All Transactions" onAction="#handleViewAllTransactions"
                                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-padding: 8 20; -fx-background-radius: 4px; -fx-font-weight: bold;"/>
                    </HBox>
                </VBox>
                <TableView fx:id="transactionTable" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-border-radius: 8px; -fx-border-color: #bbdef5; -fx-border-width: 1;">
                    <columns>
                        <TableColumn fx:id="transTypeColumn" text="Type" prefWidth="100"/>
                        <TableColumn fx:id="transAmountColumn" text="Amount" prefWidth="120"/>
                        <TableColumn fx:id="transDateColumn" text="Date" prefWidth="160"/>
                        <TableColumn fx:id="transDescriptionColumn" text="Description" prefWidth="200"/>
                        <TableColumn fx:id="transPerformedByColumn" text="Performed By" prefWidth="130"/>
                        <TableColumn fx:id="transAccountNumberColumn" text="Account" prefWidth="130">
                            <cellValueFactory>
                                <PropertyValueFactory property="accountNumber"/>
                            </cellValueFactory>
                        </TableColumn>
                    </columns>
                    <placeholder>
                        <Label text="Enter an account number and click Search, or click View All Transactions."
                               style="-fx-text-fill: #999; -fx-font-size: 14px;"/>
                    </placeholder>
                </TableView>
            </VBox>
        </Tab>
    </TabPane>
</VBox>
